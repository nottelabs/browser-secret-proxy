# Release image: GoReleaser builds the binaries, this only packages them.
# Keep the final stage identical to the one in Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETPLATFORM
# GoReleaser passes its project name; the path inside the image stays fixed.
ARG BINARY=browser-secret-proxy
COPY $TARGETPLATFORM/${BINARY} /usr/local/bin/browser-secret-proxy
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/browser-secret-proxy", "-listen", ":8080"]
